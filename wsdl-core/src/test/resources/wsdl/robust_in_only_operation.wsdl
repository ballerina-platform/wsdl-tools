<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                   xmlns:soap12="http://schemas.xmlsoap.org/wsdl/soap12/"
                   xmlns:xs="http://www.w3.org/2001/XMLSchema"
                   xmlns:tns="http://example.org/robustinonly"
                   targetNamespace="http://example.org/robustinonly">

    <wsdl:types>
        <xs:schema targetNamespace="http://example.org/robustinonly">
            <xs:element name="addUserRequest">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="username" type="xs:string"/>
                        <xs:element name="password" type="xs:string"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:schema>
    </wsdl:types>

    <wsdl:message name="addUserRequest">
        <wsdl:part name="parameters" element="tns:addUserRequest"/>
    </wsdl:message>
    <wsdl:message name="UserStoreException">
        <wsdl:part name="parameters" element="tns:addUserRequest"/>
    </wsdl:message>

    <wsdl:portType name="UserStoreServicePortType">
        <wsdl:operation name="addUser">
            <wsdl:input message="tns:addUserRequest"/>
            <wsdl:fault message="tns:UserStoreException" name="UserStoreException"/>
        </wsdl:operation>
    </wsdl:portType>

    <wsdl:binding name="UserStoreServiceSoap12Binding" type="tns:UserStoreServicePortType">
        <soap12:binding transport="http://schemas.xmlsoap.org/soap/http" style="document"/>
        <wsdl:operation name="addUser">
            <soap12:operation soapAction="urn:addUser"/>
            <wsdl:input>
                <soap12:body use="literal"/>
            </wsdl:input>
            <wsdl:fault name="UserStoreException">
                <soap12:fault name="UserStoreException" use="literal"/>
            </wsdl:fault>
        </wsdl:operation>
    </wsdl:binding>

    <wsdl:service name="UserStoreService">
        <wsdl:port name="UserStoreServiceSoap12Port" binding="tns:UserStoreServiceSoap12Binding">
            <soap12:address location="https://localhost:9443/services/UserStoreService"/>
        </wsdl:port>
    </wsdl:service>
</wsdl:definitions>
